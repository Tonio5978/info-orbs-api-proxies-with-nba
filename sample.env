# These environment variables are used to configure the proxies.
# You can copy this file to .env and modify the values as needed 
# or you can set these variables in your environment directly.
# The default values are provided for reference.

# Only uncomment the lines you want to override the default.

# Time zone of the log timestamps (default UTC); the data itself doesn't depend on it
# TZ="Europe/Paris"

# Max cache-bypassing requests (force=true) per client IP per minute, for each proxy
# FORCE_REFRESH_PER_MINUTE="2"

# TIMEZONE_PROXY_REQUESTS_PER_MINUTE="5"
# TIMEZONE_RETRY_DELAY="0"
# TIMEZONE_MAX_RETRIES="0"
# TIMEZONE_CACHE_DB="/var/cache/timezone_proxy/timezone_cache.db"

# ZONEINFO_PROXY_REQUESTS_PER_MINUTE="5"

# VISUALCROSSING_PROXY_REQUESTS_PER_MINUTE="5"
# VISUALCROSSING_PROXY_CACHE_LIFE="5"  # Set to 0 to disable

# TWELVEDATA_PROXY_REQUESTS_PER_MINUTE="15"
# TWELVEDATA_PROXY_CACHE_LIFE="5" # Set to 0 to disable

# TEMPEST_PROXY_REQUESTS_PER_MINUTE="5"
# TEMPEST_PROXY_CACHE_LIFE="5"         # Set to 0 to disable

# OPENWEATHER_PROXY_REQUESTS_PER_MINUTE="5"
# OPENWEATHER_PROXY_CACHE_LIFE="5"         # Set to 0 to disable

# PARQET_PROXY_REQUESTS_PER_MINUTE="5"
# PARQET_PROXY_CACHE_LIFE="5"         # Set to 0 to disable

# MLBDATA_PROXY_REQUESTS_PER_MINUTE="15"
# MLBDATA_PROXY_CACHE_LIFE="5"         # Set to 0 to disable

# NFLDATA_PROXY_REQUESTS_PER_MINUTE="15"
# NFLDATA_PROXY_CACHE_LIFE="5"         # Set to 0 to disable

# NBADATA_PROXY_REQUESTS_PER_MINUTE="15"
# NBADATA_PROXY_CACHE_LIFE="5"         # Set to 0 to disable
# NBADATA_PROXY_LIVE_CACHE_SECONDS="60"       # Team data cache of /proxy while the team is playing
# NBADATA_PROXY_LIVE_REFRESH_SECONDS="10"     # Scoreboards (/scores, liveGame) during games
# NBADATA_PROXY_IDLE_REFRESH_MINUTES="30"     # Scoreboards outside games, and /upcoming
# NBADATA_PROXY_PREMATCH_MINUTES="10"         # Fast refresh starts this long before tip-off
# NBADATA_PROXY_STANDINGS_LIVE_REFRESH_MINUTES="5"  # /nbadata/standings during games (30 min otherwise)

# SOCCER_PROXY_REQUESTS_PER_MINUTE="60"
# SOCCER_PROXY_DAYS_BEFORE="1"              # Window start (J-1)
# SOCCER_PROXY_DAYS_AFTER="14"              # Window end (J+14)
# SOCCER_PROXY_TZ="Europe/Paris"            # Time zone defining "today"
# SOCCER_PROXY_LIVE_REFRESH_SECONDS="20"    # While a match is live or about to start
# SOCCER_PROXY_PREMATCH_MINUTES="10"
# SOCCER_PROXY_IDLE_REFRESH_MINUTES="60"     # Matches outside live periods
# SOCCER_PROXY_STANDINGS_REFRESH_MINUTES="120" # League tables outside live periods
# SOCCER_PROXY_TEAMS_REFRESH_HOURS="24"
# SOCCER_PROXY_REQUEST_PAUSE_MS="1000"      # Pause between two ESPN requests
# SOCCER_PROXY_RETRY_BASE_SECONDS="30"      # First retry delay after an ESPN error, doubled each time
# SOCCER_PROXY_SCORES_REFRESH_MINUTES="5"   # /soccer/scores when no configured competition is playing
# SOCCER_PROXY_UPCOMING_REFRESH_MINUTES="30" # /soccer/upcoming
# SOCCER_PROXY_LAST_REFRESH_MINUTES="60"     # /soccer/lastMatches (previous day)
# SOCCER_PROXY_STANDINGS_LIVE_REFRESH_MINUTES="10" # /soccer/{key}Standings while the competition has a live match

## API Keys
OPENWEATHER_DEFAULT_API_KEY="SOME-KEY-HERE"
TEMPEST_DEFAULT_API_KEY="SOME-KEY-HERE"
TWELVEDATA_DEFAULT_API_KEY="SOME-KEY-HERE"
VISUALCROSSING_DEFAULT_API_KEY="SOME-KEY-HERE"

#TOP_TIMEZONES="America/New_York,America/Chicago,America/Denver,America/Los_Angeles,America/Toronto,Europe/London,Europe/Paris,Europe/Berlin,Asia/Tokyo,Asia/Shanghai,Asia/Kolkata,America/Sao_Paulo,Australia/Sydney,Pacific/Auckland,Asia/Dubai,Asia/Singapore,America/Mexico_City,Europe/Moscow,Africa/Johannesburg,Asia/Jakarta,Asia/Bangkok,America/Argentina/Buenos_Aires,Asia/Seoul,Asia/Taipei,America/Vancouver,Europe/Madrid,Europe/Rome,Europe/Amsterdam,Europe/Stockholm,Asia/Hong_Kong,Asia/Kuala_Lumpur,Asia/Manila,Asia/Ho_Chi_Minh,Asia/Riyadh,Asia/Karachi,Asia/Dhaka,Africa/Cairo,Africa/Lagos,Africa/Nairobi,Australia/Melbourne,Australia/Perth,America/Phoenix,America/Bogota,America/Lima,America/Santiago,America/Caracas,Europe/Lisbon,Europe/Zurich,Europe/Athens,Europe/Brussels"
